# Copy to .env and fill real values. Never commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173,http://localhost:5174

DB_DRIVER=pglite
PGLITE_DIR=.data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/fuelcost

# Secret values live in a secrets manager in staging/production. Names only here.
# Maps: auto picks geoapify -> google -> mock, whichever key is present.
MAPS_PROVIDER=auto
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=
JWT_SECRET=
SENTRY_DSN=

# Admin bootstrap (used once by `npm run admin:boot`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
