{
  "name": "@fce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-migrations.mjs && tsc -p tsconfig.build.json && node --watch-path=dist dist/main.js",
    "start": "node dist/main.js",
    "build": "node scripts/build-migrations.mjs && tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "typecheck": "node scripts/build-migrations.mjs && tsc --noEmit",
    "db:migrate": "tsx src/db/cli-migrate.ts",
    "admin:boot": "tsx src/db/cli-admin.ts",
    "admin:reset": "tsx src/db/cli-admin-reset.ts",
    "db:generate": "node scripts/build-migrations.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@fce/contracts": "*",
    "@fce/engine": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@sentry/node": "^8.47.0",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
