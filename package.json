{
  "name": "fuel-cost-estimator",
  "private": true,
  "version": "1.0.0",
  "description": "Fuel Cost Estimator (Pakistan) - Phase 1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w @fce/api",
    "dev:web": "npm run dev -w @fce/web",
    "dev:admin": "npm run dev -w @fce/admin",
    "db:migrate": "npm run db:migrate -w @fce/api",
    "db:seed": "npm run db:seed -w @fce/api",
    "admin:boot": "npm run admin:boot -w @fce/api",
    "admin:reset": "npm run admin:reset -w @fce/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
